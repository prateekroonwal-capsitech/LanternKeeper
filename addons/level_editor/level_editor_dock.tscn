[gd_scene format=3 uid="uid://c6level_dock_001"]

[ext_resource type="Script" path="res://addons/level_editor/level_editor_dock.gd" id="1_dock"]

[node name="LevelEditorDock" type="VBoxContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 10
script = ExtResource("1_dock")

[node name="Header" type="Label" parent="."]
