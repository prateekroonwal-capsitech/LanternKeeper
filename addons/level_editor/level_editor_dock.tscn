[node name="WorldRow" type="HBoxContainer" parent="NewLevelSection"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="WorldLabel" type="Label" parent="NewLevelSection/WorldRow"]
layout_mode = 2
