[node name="SuggestionRow" type="HBoxContainer" parent="NewLevelSection"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="SuggestionLabel" type="Label" parent="NewLevelSection/SuggestionRow"]
unique_name_in_owner = true
layout_mode = 2
